# Copia este archivo a .env y cambia la clave. No subas .env al repositorio.
POSTGRES_USER=telemetria
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=telemetria

# DATABASE_URL no va aquí: docker-compose.yml la arma con las variables
# anteriores y el host "db" (nombre del servicio en la red de Compose).

# Pendiente: la app aún no llama a Inventario (ClienteActivosFalso).
# Cuando exista el cliente real, la URL va por variable de entorno.
# Dentro de un contenedor, 127.0.0.1 es el propio contenedor:
#   mock Prism en tu máquina -> http://host.docker.internal:4010
#   Inventario real en EC2   -> la URL de la hoja Coordinacion_Voltrix
# INVENTARIO_URL=
